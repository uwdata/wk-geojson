{
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  }
}
